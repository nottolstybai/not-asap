{
  "uid": "notasap-playground",
  "title": "not-asap playground",
  "schemaVersion": 39,
  "version": 3,
  "timezone": "",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Total Enqueued by Job Type",
      "description": "Cumulative jobs ever inserted, per type. Not a rate — shows the running total.",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "notasap-prom" },
      "targets": [
        {
          "expr": "sum by (job_type) (notasap_jobs_enqueued_total)",
          "legendFormat": "{{job_type}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "minVizWidth": 0,
        "minVizHeight": 16,
        "namePlacement": "auto",
        "showUnfilled": true,
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "noValue": "0",
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Total Processed by Status",
      "description": "Cumulative terminal-state transitions (done, failed, cancelled, exhausted). Not a rate.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "notasap-prom" },
      "targets": [
        {
          "expr": "sum by (status) (notasap_jobs_processed_total)",
          "legendFormat": "{{status}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "noValue": "0",
          "mappings": [],
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "done" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#73bf69", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#f2495c", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "exhausted" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#ff9830", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "cancelled" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#8ab8ff", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Enqueue Rate by Job Type",
      "description": "Rate of jobs being inserted per second, per type.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "notasap-prom" },
      "targets": [
        {
          "expr": "sum by (job_type) (rate(notasap_jobs_enqueued_total[1m]))",
          "legendFormat": "{{job_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisLabel": "t/s",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 4,
      "title": "Succeeded Rate",
      "description": "Rate of jobs reaching status=done per second, per type.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "notasap-prom" },
      "targets": [
        {
          "expr": "sum by (job_type) (rate(notasap_jobs_processed_total{status=\"done\"}[1m]))",
          "legendFormat": "{{job_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisLabel": "t/s",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 5,
      "title": "Failed / Exhausted / Cancelled Rate",
      "description": "Rate of jobs reaching non-successful terminal statuses per second.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "notasap-prom" },
      "targets": [
        {
          "expr": "sum by (status) (rate(notasap_jobs_processed_total{status=~\"failed|exhausted|cancelled\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisLabel": "t/s",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 6,
      "title": "Job Duration p50 / p95 / p99 by Type",
      "description": "Handler execution time from worker claim to handler return.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 18, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "notasap-prom" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5,  sum by (le, job_type) (rate(notasap_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{job_type}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(notasap_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{job_type}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, job_type) (rate(notasap_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{job_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "axisLabel": "seconds",
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 4,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      }
    },
    {
      "id": 7,
      "title": "Jobs in Flight",
      "description": "Number of job goroutines currently executing.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "notasap-prom" },
      "targets": [
        { "expr": "notasap_jobs_in_flight", "legendFormat": "in flight", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red",    "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "DB Poll Latency p95",
      "description": "Time spent in a single ClaimJob round-trip to Postgres.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "notasap-prom" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(notasap_poll_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "—",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red",    "value": 0.2 }
            ]
          }
        }
      }
    }
  ]
}
